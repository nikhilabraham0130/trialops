# Application runtime mode
TRIALOPS_ENV=development

# Application logging verbosity
TRIALOPS_LOG_LEVEL=INFO

# Docker-managed local PostgreSQL server
TRIALOPS_POSTGRES_USER=trialops
TRIALOPS_POSTGRES_PASSWORD=change-me-for-local-development
TRIALOPS_POSTGRES_DB=trialops
TRIALOPS_POSTGRES_PORT=55432

# Local PostgreSQL connection used by SQLAlchemy and Psycopg
TRIALOPS_DATABASE_URL=postgresql+psycopg://trialops:change-me-for-local-development@127.0.0.1:55432/trialops

# Browser addresses permitted to call FastAPI directly (JSON array syntax)
TRIALOPS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
